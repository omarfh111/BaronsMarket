APP_NAME=Smart Shopping Assistant API
APP_HOST=0.0.0.0
APP_PORT=8000

# Model 1 - Product detection/retrieval
MODEL_DIR=../model/model_1
YOLO_MODEL_PATH=../model/model_1/best.pt
FAISS_INDEX_PATH=../model/model_1/index.faiss
PRODUCT_EMBEDDINGS_PATH=../model/model_1/product_embeddings_aug.npy
PRODUCTS_JSON_PATH=../model/model_1/products_clean .json
YOLO_CONFIDENCE=0.25
TOP_K=3
MODEL_DEVICE=auto

# Model 3 - Animal/Bag
MODEL3_WEIGHTS_PATH=../ml/models/model_3/final_model_efficientnetB0_____ (1).pth
MODEL3_IMAGE_SIZE=224

# Model 4 - Theft
MODEL4_PERSON_WEIGHTS_PATH=../ml/models/model_4/person_model.pt
MODEL4_THEFT_WEIGHTS_PATH=../ml/models/model_4/theft_model.pt

# Model 5 - Queue recommendation
MODEL5_WEIGHTS_PATH=../ml/models/model_5/yolov8m.pt
MODEL5_QUEUE_ZONES_PATH=../model/model_5/queue_zones.json
MODEL5_OUTPUT_DIR=./outputs/model5

# Model 6 - Vegetable freshness
MODEL6_WEIGHTS_PATH=../model/model_6/mobilenet_v3_large_best.pt
MODEL6_PIPELINE_STATE_PATH=../model/model_6/pipeline_state.pkl

# Model 7 - Fidelity card validation
MODEL7_CHECKPOINT_PATH=../model/model_7/fidelity_checkpoint_20260501_1147.pth
MODEL7_DB_JSON_PATH=../model/model_7/fidelity_db.json
MODEL7_CNN_THRESHOLD=0.75

# Model 8 - Forged document detection
MODEL8_CODE_DIR=../ml/models/model_8_code
MODEL8_CHECKPOINT_PATH=../ml/models/model_8/dtd_seg_finetuned_best.pth
MODEL8_THRESHOLD=0.000240
MODEL8_QUALITY=90
MODEL8_FORGED_CLASS_IDX=1
MODEL8_REQUIRE_TRUE_JPEG=true

# Catalog
MARKET_CATALOG_DIR=../market

# OpenAI multi-agent recommendation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase checkout persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CHECKOUT_TABLE=checkout_sessions

# Qdrant retrieval layer
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=product_knowledge
